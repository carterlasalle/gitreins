# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# GitReins sandbox (evaluation scratch space)
.gitreins-sandbox/
# GitReins guard history (runtime artifacts, no versioning needed)
.gitreins/history/
# Runtime task data (committed separately on gitreins branch)
.gitreins/tasks.yaml

# Secrets
.env
*.key
*.pem

# Test artifacts
.coverage
.skylos/
# Node (if present from bootstrap)
node_modules/
apps/
packages/
temporal-vector/
# Temp
test_write
*.tmp
*.db

# Cross-project artifacts (not part of GitReins)
category-mapping.yaml
hivemind-audit.md

# GitReins nested runtime artifacts
.gitreins/.gitreins/
.gitreins/config.yaml.bak
# Review-run archives (DESIGN_v2.md §13 — derived artifacts, rebuildable per run)
review_runs/

# Hilo — local cache files (rebuildable; edges.jsonl/manifest churn per scan)
.vfs/

# Demo projects (own git repos, not part of GitReins source)
demo-calc/
demo-slugify/

# Board JSONL mirrors — this project tracks parquet only (see gitreins-poc-foreman-ops)

.coding-hermes/board/board.db
.coding-hermes/board/board.db.wal
.coding-hermes/board/*.parquet
.coding-hermes/board/*.duckdb
